# GatherWise Server Environment Configuration
# For Local Development:
# Copy this file to .env and supply your secret Gemini API key to enable live AI generation.
# If GEMINI_API_KEY is not provided, GatherWise runs in a clearly labeled, fully functional Sample Mode.
PORT=3001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For Render Deployment (Single Node Web Service):
# Add GEMINI_API_KEY (and optionally GEMINI_MODEL) in the Render Dashboard under Environment Variables.
# Render automatically injects PORT and sets NODE_ENV=production. Do not commit actual secrets.

